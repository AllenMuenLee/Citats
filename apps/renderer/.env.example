# apps/renderer environment template. Copy to `.env.local` for local
# overrides (Next.js loads `.env.local` automatically and it is gitignored).
# Phase 0 only implements GET /api/health, which reads no environment
# variables -- the entries below are placeholders for the orchestrator work
# that lands in a later phase.
#
# Note: the per-launch browser-service auth token (BROWSER_SERVICE_TOKEN) is
# intentionally NOT listed here. apps/desktop generates it at process
# startup and passes it directly to the services/browser child process's
# environment -- it must never live in a .env file. See
# docs/features/p00-f01-monorepo-environment.md.

# Base URL the Next.js backend orchestrator will use to reach the Python
# browser service (services/browser).
BROWSER_SERVICE_URL=http://localhost:8000

# Reasoning/tool-calling LLM; not called in Phase 0.
MISTRAL_API_KEY=changeme
