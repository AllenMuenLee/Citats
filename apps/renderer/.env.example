# apps/renderer environment template. Copy to `.env.local` for local
# overrides (Next.js loads `.env.local` automatically and it is gitignored).
#
# Note: the per-launch browser-service auth token (BROWSER_SERVICE_TOKEN) is
# intentionally NOT listed here. apps/desktop generates it at process
# startup and passes it directly to the services/browser child process's
# environment -- it must never live in a .env file.

# Base URL the Next.js backend orchestrator will use to reach the Python
# browser service (services/browser).
BROWSER_SERVICE_URL=http://localhost:8000

# --- Model providers -------------------------------------------------------
# Two providers are supported: `Gemini` and `Groq` (case-insensitive). Only
# the key(s) for the providers actually named below need to be set.
GEMINI_API_KEY=changeme
GROQ_API_KEY=changeme

# Optional API roots. Both must be HTTPS and carry no credentials.
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/
# GROQ_API_BASE_URL=https://api.groq.com/openai/v1/

# --- Model roles -----------------------------------------------------------
# Each role picks its own provider, so they can be mixed freely.

# Answers the user, runs the hosted online search, and calls the local tools.
# Required -- the chat endpoint returns 503 without it.
CHAT_MODEL_PROVIDER=Gemini
CHAT_MODEL=gemini-3.5-flash

# Reads one browser.explore_website observation of a rendered page and
# compresses it into the closed-schema digest a generative-UI plan is built
# from. It has no local tools and no hosted tools and never answers the user.
# Unset, the deterministic projection in
# apps/renderer/src/server/orchestrator/model-view.ts is used alone. A cheap,
# large-context model is the right choice here.
EXTRACTION_MODEL_PROVIDER=Gemini
EXTRACTION_MODEL=gemini-3.5-flash-lite

# Writes the final React component for generative UI. Required for generative
# UI: when unset, the orchestrator never calls the UI-generation agent, even
# after a successful website exploration -- see
# apps/renderer/src/app/api/chat/route.ts.
UI_MODEL_PROVIDER=Gemini
UI_MODEL=gemma-4-31B

# --- Shared model transport ------------------------------------------------
# Bounds one attempt against any provider.
AI_TIMEOUT_MS=60000

# Retries for a rate-limited (429) or 5xx/transport failure.
AI_MAX_RETRIES=2

# Total wall-clock budget for that backoff, independent of AI_TIMEOUT_MS
# (which bounds a single attempt). See
# apps/renderer/src/server/ai/streaming.ts.
AI_RETRY_MAX_ELAPSED_MS=120000

# --- Chat orchestration ----------------------------------------------------
# Runaway-loop backstop for one chat turn's tool loop -- not a time limit.
# A turn otherwise runs until the model finishes or the user presses Stop;
# raise this only if a legitimate turn (several real browser.explore_website
# / navigate_and_extract calls, then UI generation) is hitting the step cap
# before finishing. See apps/renderer/src/server/orchestrator/config.ts.
CHAT_MAX_STEPS=25

# How much prior-turn history one CHAT_MODEL request may re-send.
CHAT_MAX_CONTEXT_TOKENS=16000

# Optional backstop, unset by default: a ceiling on what the CURRENT turn's
# tool loop may accumulate, past which its oldest tool results are replaced by
# a stub. Leave it unset unless the account's per-minute token rate limit is
# still being hit -- with it unset, a turn keeps every result it gathered.
# It never applies to UI generation, which runs on UI_MODEL with its own
# budget and always receives the full page-understanding graph.
# CHAT_MAX_RUN_TOKENS=12000

# Set to 1 to log each model call's reported prompt/completion tokens.
CHAT_LOG_TOKEN_USAGE=0
