# Root environment template for local development.
#
# Copy this file to `.env` (and/or `.env.local` for apps/web, which Next.js
# loads automatically) and fill in real values for anything beyond the dev
# defaults below. NEVER commit a file named `.env` or `.env.local` -- see
# .gitignore. Values here are placeholders/dev-only defaults, not real
# secrets.
#
# Host/port values default to `localhost` because apps/web and
# services/browser run directly on the host in Phase 0 (they are not
# containerized). If a future phase adds a container profile for the app
# services, override these to the compose service names (`postgres`,
# `redis`) via a separate `.env` for that profile.

# --- Postgres (conversation/session history, discovered API maps) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_browser_dev
POSTGRES_USER=ai_browser_dev
POSTGRES_PASSWORD=devpassword

# --- Redis (hot session state) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=devpassword

# --- Mistral (reasoning/tool-calling LLM; not called in Phase 0) ---
MISTRAL_API_KEY=changeme

# --- Browser service (FastAPI + Nodriver) ---
# Base URL the Next.js orchestrator will use to reach services/browser.
BROWSER_SERVICE_URL=http://localhost:8000

# --- Secrets vault (kept out of LLM context; not wired up in Phase 0) ---
SECRETS_VAULT_ADDR=changeme
SECRETS_VAULT_TOKEN=changeme

# --- Browser-service local auth (deliberately NOT an env var here) ---
# apps/desktop generates a random per-launch token (crypto.randomBytes) and
# passes it directly to the services/browser child process's environment as
# BROWSER_SERVICE_TOKEN. It is never read from a .env file, logged, or sent
# to the renderer -- see docs/features/p00-f01-monorepo-environment.md.
