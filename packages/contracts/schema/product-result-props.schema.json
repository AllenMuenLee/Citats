{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "component_instance_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "freshness": {
      "additionalProperties": false,
      "properties": {
        "retrieved_at": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
        },
        "stale_after": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
        }
      },
      "required": [
        "retrieved_at"
      ],
      "type": "object"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "attributes": {
            "default": [],
            "items": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "maxLength": 80,
                  "minLength": 1,
                  "type": "string"
                },
                "unit": {
                  "maxLength": 24,
                  "minLength": 1,
                  "type": "string"
                },
                "value": {
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "name",
                "value"
              ],
              "type": "object"
            },
            "maxItems": 12,
            "type": "array"
          },
          "availability": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "image_url": {
            "format": "uri",
            "maxLength": 2048,
            "type": "string"
          },
          "merchant": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "partial_data_warnings": {
            "default": [],
            "items": {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 8,
            "type": "array"
          },
          "price": {
            "additionalProperties": false,
            "properties": {
              "amount": {
                "pattern": "^\\d{1,12}(?:\\.\\d{1,4})?$",
                "type": "string"
              },
              "currency": {
                "pattern": "^[A-Z]{3}$",
                "type": "string"
              },
              "qualifier": {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              "unit": {
                "maxLength": 40,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "amount",
              "currency"
            ],
            "type": "object"
          },
          "source_ids": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "merchant",
          "availability",
          "attributes",
          "source_ids",
          "partial_data_warnings"
        ],
        "type": "object"
      },
      "maxItems": 50,
      "type": "array"
    },
    "query": {
      "maxLength": 300,
      "type": "string"
    },
    "sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "url": {
            "format": "uri",
            "maxLength": 2048,
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "title",
          "url"
        ],
        "type": "object"
      },
      "maxItems": 30,
      "minItems": 1,
      "type": "array"
    },
    "warnings": {
      "default": [],
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "partial_data",
              "stale_data",
              "inconsistent_data",
              "validation_failed"
            ],
            "type": "string"
          },
          "message": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "maxItems": 10,
      "type": "array"
    }
  },
  "required": [
    "component_instance_id",
    "query",
    "items",
    "sources",
    "freshness",
    "warnings"
  ],
  "type": "object"
}
