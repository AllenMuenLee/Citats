{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "artifactId": {
      "pattern": "^gui_[a-f0-9]{64}$",
      "type": "string"
    },
    "expiresAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "fallbackText": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "manifest": {
      "additionalProperties": false,
      "properties": {
        "accessibilityFeatures": {
          "items": {
            "enum": [
              "heading_order",
              "landmarks",
              "labels",
              "descriptions",
              "table_relationships",
              "live_status",
              "keyboard",
              "visible_focus",
              "accessible_media",
              "modal_escape"
            ],
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "componentIds": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "factIds": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "fallback": {
          "type": "boolean"
        },
        "localInteractions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "boundedValues": {
                "exclusiveMinimum": 0,
                "maximum": 10000,
                "type": "integer"
              },
              "kind": {
                "enum": [
                  "selection",
                  "filter",
                  "sort",
                  "expansion",
                  "tab",
                  "gallery",
                  "modal"
                ],
                "type": "string"
              },
              "stateKey": {
                "maxLength": 100,
                "minLength": 1,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                "type": "string"
              }
            },
            "required": [
              "stateKey",
              "kind",
              "boundedValues"
            ],
            "type": "object"
          },
          "maxItems": 32,
          "type": "array"
        },
        "mediaIds": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "planDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "recordIds": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "responsiveRegions": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "type": "array"
        },
        "runtimeImports": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9]*$",
            "type": "string"
          },
          "maxItems": 64,
          "type": "array"
        },
        "sourceIds": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        }
      },
      "required": [
        "planDigest",
        "sourceIds",
        "recordIds",
        "factIds",
        "mediaIds",
        "componentIds",
        "localInteractions",
        "accessibilityFeatures",
        "responsiveRegions",
        "runtimeImports",
        "fallback"
      ],
      "type": "object"
    },
    "modelDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "module": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "encoding": {
              "const": "base64",
              "type": "string"
            },
            "kind": {
              "const": "bytes",
              "type": "string"
            },
            "value": {
              "maxLength": 512000,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "encoding",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "byteLength": {
              "maximum": 384000,
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "bundle_reference",
              "type": "string"
            },
            "reference": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reference",
            "byteLength"
          ],
          "type": "object"
        }
      ]
    },
    "planDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "promptDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "sourceMapPolicy": {
      "const": "omitted",
      "type": "string"
    },
    "toolchainDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "validation": {
      "additionalProperties": false,
      "properties": {
        "issues": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "maxLength": 100,
                "minLength": 1,
                "pattern": "^[A-Z][A-Z0-9_]*$",
                "type": "string"
              },
              "location": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "column": {
                        "maximum": 9007199254740991,
                        "minimum": 0,
                        "type": "integer"
                      },
                      "line": {
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "line",
                      "column"
                    ],
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "severity": {
                "enum": [
                  "error",
                  "warning"
                ],
                "type": "string"
              }
            },
            "required": [
              "code",
              "severity",
              "location"
            ],
            "type": "object"
          },
          "maxItems": 256,
          "type": "array"
        },
        "valid": {
          "type": "boolean"
        }
      },
      "required": [
        "valid",
        "issues"
      ],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "artifactId",
    "module",
    "manifest",
    "validation",
    "sourceMapPolicy",
    "planDigest",
    "inputDigest",
    "promptDigest",
    "modelDigest",
    "toolchainDigest",
    "expiresAt",
    "fallbackText"
  ],
  "type": "object"
}
