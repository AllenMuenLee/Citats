{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "arguments": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "maxLength": 2048,
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "contractVersion": {
      "const": 1,
      "type": "number"
    },
    "correlation": {
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "type": "string"
        },
        "sessionId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "type": "string"
        },
        "taskId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "type": "string"
        },
        "userId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "userId"
      ],
      "type": "object"
    },
    "toolCallId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "type": "string"
    },
    "toolName": {
      "const": "browser.navigate_and_extract",
      "type": "string"
    }
  },
  "required": [
    "contractVersion",
    "correlation",
    "toolCallId",
    "toolName",
    "arguments"
  ],
  "type": "object"
}
