{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "argsSchemaRef": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "argsSchemaVersion": {
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "type": "integer"
    },
    "contractVersion": {
      "const": 1,
      "type": "number"
    },
    "description": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "maxLength": 64,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "type": "string"
    },
    "sensitiveByDefault": {
      "type": "boolean"
    }
  },
  "required": [
    "contractVersion",
    "name",
    "description",
    "argsSchemaVersion",
    "argsSchemaRef",
    "sensitiveByDefault"
  ],
  "type": "object"
}
