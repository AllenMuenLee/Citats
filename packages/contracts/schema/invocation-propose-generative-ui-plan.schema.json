{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "arguments": {
      "additionalProperties": false,
      "properties": {
        "detailRegionHandles": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "maxItems": 5,
          "type": "array"
        },
        "externalWorkflowIntents": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "maxItems": 10,
          "type": "array"
        },
        "filters": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "field": {
                "enum": [
                  "title",
                  "description",
                  "image",
                  "audio",
                  "video",
                  "price",
                  "rating",
                  "date",
                  "amenity",
                  "availability",
                  "provider",
                  "action"
                ],
                "type": "string"
              },
              "operator": {
                "enum": [
                  "equals",
                  "contains",
                  "range",
                  "exists"
                ],
                "type": "string"
              },
              "value": {
                "anyOf": [
                  {
                    "maxLength": 200,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "field",
              "operator",
              "value"
            ],
            "type": "object"
          },
          "maxItems": 10,
          "type": "array"
        },
        "freshness": {
          "enum": [
            "live",
            "cached",
            "unknown"
          ],
          "type": "string"
        },
        "groupBy": {
          "anyOf": [
            {
              "enum": [
                "title",
                "description",
                "image",
                "audio",
                "video",
                "price",
                "rating",
                "date",
                "amenity",
                "availability",
                "provider",
                "action"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "layoutKind": {
          "enum": [
            "list",
            "grid",
            "card_grid",
            "table",
            "comparison",
            "gallery",
            "timeline",
            "map",
            "detail",
            "generic_collection",
            "cited_text"
          ],
          "type": "string"
        },
        "localInteractionIntents": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "maxItems": 10,
          "type": "array"
        },
        "mediaPlacement": {
          "enum": [
            "leading",
            "trailing",
            "background",
            "none"
          ],
          "type": "string"
        },
        "observationId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        "orderBy": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "direction": {
                  "enum": [
                    "asc",
                    "desc"
                  ],
                  "type": "string"
                },
                "field": {
                  "enum": [
                    "title",
                    "description",
                    "image",
                    "audio",
                    "video",
                    "price",
                    "rating",
                    "date",
                    "amenity",
                    "availability",
                    "provider",
                    "action"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "field",
                "direction"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "additionalProperties": false,
          "properties": {
            "retrievedAt": {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string"
            },
            "sourceUrl": {
              "maxLength": 2048,
              "type": "string"
            }
          },
          "required": [
            "sourceUrl",
            "retrievedAt"
          ],
          "type": "object"
        },
        "selectedFields": {
          "items": {
            "enum": [
              "title",
              "description",
              "image",
              "audio",
              "video",
              "price",
              "rating",
              "date",
              "amenity",
              "availability",
              "provider",
              "action"
            ],
            "type": "string"
          },
          "maxItems": 24,
          "type": "array"
        },
        "sourceCollectionHandles": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "maxItems": 10,
          "type": "array"
        },
        "warnings": {
          "items": {
            "maxLength": 300,
            "type": "string"
          },
          "maxItems": 10,
          "type": "array"
        }
      },
      "required": [
        "observationId",
        "layoutKind",
        "sourceCollectionHandles",
        "selectedFields",
        "groupBy",
        "orderBy",
        "filters",
        "detailRegionHandles",
        "mediaPlacement",
        "provenance",
        "freshness",
        "warnings",
        "localInteractionIntents",
        "externalWorkflowIntents"
      ],
      "type": "object"
    },
    "contractVersion": {
      "const": 1,
      "type": "number"
    },
    "correlation": {
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "type": "string"
        },
        "sessionId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "type": "string"
        },
        "taskId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "type": "string"
        },
        "userId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "userId"
      ],
      "type": "object"
    },
    "toolCallId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "type": "string"
    },
    "toolName": {
      "const": "ui.propose_generative_ui_plan",
      "type": "string"
    }
  },
  "required": [
    "contractVersion",
    "correlation",
    "toolCallId",
    "toolName",
    "arguments"
  ],
  "type": "object"
}
