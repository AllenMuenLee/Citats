{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "correlation": {
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "type": "string"
        },
        "sessionId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "type": "string"
        },
        "taskId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "type": "string"
        },
        "userId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "userId"
      ],
      "type": "object"
    },
    "implementationPrompt": {
      "maxLength": 200000,
      "minLength": 1,
      "type": "string"
    },
    "implementationPromptDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "limits": {
      "additionalProperties": false,
      "properties": {
        "maxAstNodes": {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "type": "integer"
        },
        "maxComplexity": {
          "exclusiveMinimum": 0,
          "maximum": 200,
          "type": "integer"
        },
        "maxLocalStateEntries": {
          "maximum": 32,
          "minimum": 0,
          "type": "integer"
        },
        "maxRenderNodes": {
          "exclusiveMinimum": 0,
          "maximum": 5000,
          "type": "integer"
        },
        "maxSourceBytes": {
          "exclusiveMinimum": 0,
          "maximum": 65536,
          "type": "integer"
        }
      },
      "required": [
        "maxSourceBytes",
        "maxAstNodes",
        "maxComplexity",
        "maxRenderNodes",
        "maxLocalStateEntries"
      ],
      "type": "object"
    },
    "plannerPromptDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "plannerPromptVersion": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:+-]+$",
      "type": "string"
    },
    "promptDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "promptVersion": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:+-]+$",
      "type": "string"
    },
    "runtime": {
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:+-]+$",
          "type": "string"
        },
        "exports": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9]*$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "module": {
          "const": "@ai-browser/generated-ui-runtime",
          "type": "string"
        }
      },
      "required": [
        "module",
        "apiVersion",
        "exports"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "theme": {
      "additionalProperties": false,
      "properties": {
        "allowedTokens": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9.-]*$",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        },
        "maximumZoomPercent": {
          "maximum": 400,
          "minimum": 100,
          "type": "integer"
        },
        "minimumTargetSize": {
          "maximum": 64,
          "minimum": 24,
          "type": "integer"
        },
        "minimumViewport": {
          "additionalProperties": false,
          "properties": {
            "height": {
              "maximum": 9007199254740991,
              "minimum": 240,
              "type": "integer"
            },
            "width": {
              "maximum": 9007199254740991,
              "minimum": 320,
              "type": "integer"
            }
          },
          "required": [
            "width",
            "height"
          ],
          "type": "object"
        },
        "supportedThemes": {
          "items": {
            "enum": [
              "light",
              "dark"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "type": "array"
        },
        "supportsReducedMotion": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": [
        "allowedTokens",
        "minimumTargetSize",
        "supportedThemes",
        "supportsReducedMotion",
        "minimumViewport",
        "maximumZoomPercent"
      ],
      "type": "object"
    },
    "trustedRequest": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
    },
    "trustedSources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "captureStatus": {
            "enum": [
              "complete",
              "truncated",
              "partial"
            ],
            "type": "string"
          },
          "finalUrl": {
            "maxLength": 2048,
            "type": "string"
          },
          "origin": {
            "maxLength": 253,
            "minLength": 1,
            "type": "string"
          },
          "retrievedAt": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "type": "string"
          },
          "sourceId": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "sourceId",
          "finalUrl",
          "origin",
          "title",
          "retrievedAt",
          "captureStatus"
        ],
        "type": "object"
      },
      "maxItems": 12,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "plannerPromptVersion",
    "plannerPromptDigest",
    "promptVersion",
    "promptDigest",
    "trustedRequest",
    "implementationPrompt",
    "implementationPromptDigest",
    "trustedSources",
    "runtime",
    "theme",
    "limits",
    "correlation"
  ],
  "type": "object"
}
