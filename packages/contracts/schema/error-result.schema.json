{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": 1,
      "type": "number"
    },
    "correlation": {
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "type": "string"
        },
        "sessionId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "type": "string"
        },
        "taskId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "type": "string"
        },
        "userId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "userId"
      ],
      "type": "object"
    },
    "errorCode": {
      "enum": [
        "INVALID_ARGUMENTS",
        "UNKNOWN_TOOL",
        "TIMEOUT",
        "CANCELLED",
        "UPSTREAM_UNAVAILABLE",
        "POLICY_BLOCKED",
        "STALE_MAP",
        "RESPONSE_DRIFT",
        "RATE_LIMITED",
        "INTERNAL"
      ],
      "type": "string"
    },
    "message": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    },
    "status": {
      "const": "error",
      "type": "string"
    },
    "toolCallId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "type": "string"
    }
  },
  "required": [
    "contractVersion",
    "correlation",
    "toolCallId",
    "status",
    "errorCode",
    "message",
    "retryable"
  ],
  "type": "object"
}
