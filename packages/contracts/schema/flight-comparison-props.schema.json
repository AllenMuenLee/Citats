{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "availability_disclaimer": {
      "maxLength": 300,
      "minLength": 1,
      "type": "string"
    },
    "component_instance_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "freshness": {
      "additionalProperties": false,
      "properties": {
        "retrieved_at": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
        },
        "stale_after": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
        }
      },
      "required": [
        "retrieved_at"
      ],
      "type": "object"
    },
    "itineraries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "baggage_caveat": {
            "maxLength": 500,
            "type": "string"
          },
          "carriers": {
            "items": {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 8,
            "minItems": 1,
            "type": "array"
          },
          "fare": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "amount": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "currency": {
                    "pattern": "^[A-Z]{3}$",
                    "type": "string"
                  },
                  "qualifier": {
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "amount",
                  "currency"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "itinerary_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "legs": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "arrival_at": {
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                  "type": "string"
                },
                "carrier": {
                  "maxLength": 100,
                  "minLength": 1,
                  "type": "string"
                },
                "departure_at": {
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                  "type": "string"
                },
                "destination": {
                  "pattern": "^[A-Z]{3}$",
                  "type": "string"
                },
                "duration_minutes": {
                  "anyOf": [
                    {
                      "exclusiveMinimum": 0,
                      "maximum": 2880,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "flight_number": {
                  "maxLength": 20,
                  "minLength": 1,
                  "type": "string"
                },
                "leg_id": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._:-]+$",
                  "type": "string"
                },
                "origin": {
                  "pattern": "^[A-Z]{3}$",
                  "type": "string"
                }
              },
              "required": [
                "leg_id",
                "origin",
                "destination",
                "departure_at",
                "arrival_at",
                "duration_minutes",
                "carrier"
              ],
              "type": "object"
            },
            "maxItems": 8,
            "minItems": 1,
            "type": "array"
          },
          "refund_caveat": {
            "maxLength": 500,
            "type": "string"
          },
          "source_ids": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 1,
            "type": "array"
          },
          "stop_count": {
            "anyOf": [
              {
                "maximum": 7,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "total_duration_minutes": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "maximum": 10080,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "default": [],
            "items": {
              "additionalProperties": false,
              "properties": {
                "code": {
                  "enum": [
                    "partial_data",
                    "stale_data",
                    "inconsistent_data",
                    "validation_failed"
                  ],
                  "type": "string"
                },
                "message": {
                  "maxLength": 300,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "type": "object"
            },
            "maxItems": 10,
            "type": "array"
          }
        },
        "required": [
          "itinerary_id",
          "legs",
          "total_duration_minutes",
          "stop_count",
          "carriers",
          "fare",
          "source_ids",
          "warnings"
        ],
        "type": "object"
      },
      "maxItems": 40,
      "type": "array"
    },
    "query": {
      "additionalProperties": false,
      "properties": {
        "destination": {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "origin": {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "destination"
      ],
      "type": "object"
    },
    "sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "url": {
            "format": "uri",
            "maxLength": 2048,
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "title",
          "url"
        ],
        "type": "object"
      },
      "maxItems": 30,
      "minItems": 1,
      "type": "array"
    },
    "warnings": {
      "default": [],
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "partial_data",
              "stale_data",
              "inconsistent_data",
              "validation_failed"
            ],
            "type": "string"
          },
          "message": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "maxItems": 20,
      "type": "array"
    }
  },
  "required": [
    "component_instance_id",
    "query",
    "itineraries",
    "sources",
    "freshness",
    "availability_disclaimer",
    "warnings"
  ],
  "type": "object"
}
