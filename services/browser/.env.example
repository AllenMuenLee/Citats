# services/browser environment template. Copy to `.env` for local
# overrides (gitignored). GET /health/ready reads only the POSTGRES_HOST /
# POSTGRES_PORT / REDIS_HOST / REDIS_PORT variables below (host/port only,
# never credentials) to perform a TCP reachability check -- it never reads
# or exposes passwords.
#
# Note: BROWSER_SERVICE_TOKEN (required by GET /health/ready and every
# future non-health route -- see src/browser_service/auth.py) is
# deliberately NOT listed here. apps/desktop's Electron main process
# generates it fresh per launch and sets it directly in this process's
# environment when spawning it; it must never live in a .env file. Running
# this service manually for local testing: set it inline, e.g.
# `BROWSER_SERVICE_TOKEN=devtoken uv run uvicorn browser_service.app:app`.

# --- Postgres (used by /health/ready reachability check only in Phase 0) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_browser_dev
POSTGRES_USER=ai_browser_dev
POSTGRES_PASSWORD=devpassword

# --- Redis (used by /health/ready reachability check only in Phase 0) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=devpassword
